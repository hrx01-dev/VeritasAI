# Firebase Admin SDK
# Prefer GOOGLE_APPLICATION_CREDENTIALS or a managed Render/GCP identity.
FIREBASE_SERVICE_ACCOUNT_PATH=
FIREBASE_WEB_API_KEY=

# Only these browser origins may call the backend.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Trained classifiers. Models are downloaded by Transformers on first use.
TEXT_MODEL_ID=hamzab/roberta-fake-news-classification
IMAGE_MODEL_ID=dima806/deepfake_vs_real_image_detection

# Temperature scaling. Set this from a held-out validation calibration run.
# 1.0 means no temperature adjustment.
DETECTION_TEMPERATURE=1.0

# Video pipeline settings
# Put FaceForensics++ Xception checkpoint at backend/models/faceforensics_xception.pth
# or set an explicit absolute path below.
XCEPTION_WEIGHTS_PATH=
VIDEO_FRAME_LIMIT=20
VIDEO_FRAME_FPS=2.0
VIDEO_FACE_LIMIT=64
VIDEO_URL_MAX_BYTES=262144000
